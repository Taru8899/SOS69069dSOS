{
  "name": "dsos-walletconnect-bridge",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Bundled by CI into android/wc_bundle.js. Runs inside a hidden Android WebView. No keys live here: the wallet app signs.",
  "scripts": {
    "test": "node test_glue.mjs",
    "build": "esbuild wc_entry.js --bundle --minify --format=iife --platform=browser --target=es2020 --define:global=window --define:process.env.NODE_ENV='\"production\"' --outfile=../android/wc_bundle.js"
  },
  "dependencies": {
    "@walletconnect/ethereum-provider": "2.17.0"
  },
  "devDependencies": {
    "esbuild": "0.21.5"
  }
}
