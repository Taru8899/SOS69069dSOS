# Copy this file to .env and fill in your own values.
# NEVER put real keys in this file. This file is public.

# Etherscan API key (get one at etherscan.io, API Dashboard)
ETHERSCAN_API_KEY=

# Optional: your own Ethereum RPC URL. Leave empty to use public RPCs.
RPC_URL=

# Optional: wallet address to show by default in the app
WALLET_ADDRESS=
